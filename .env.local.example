# =============================================================================
# LINKER — Environment Variable Template
# Copy this file to .env.local and fill in the values for local development.
# Spec: §1.2 Environment and Secrets Baseline
# Rules:
#   - NEVER commit real secrets or credentials to Git
#   - Every variable is validated at startup via Zod (lib/env.ts)
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Supabase — Database & Auth ────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
# Get these from: https://www.linkedin.com/developers/apps → Auth tab
# LINKEDIN_REDIRECT_URI must match EXACTLY what's configured in your LinkedIn app
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback/linkedin

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Get bot token from: https://t.me/BotFather → /newbot
# TELEGRAM_WEBHOOK_SECRET: any random 256-bit hex string you generate
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN_HERE
TELEGRAM_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET_MIN_32_CHARS

# ── Polar.sh Billing ──────────────────────────────────────────────────────────
# Get these from: https://polar.sh/dashboard → Settings → API
POLAR_ACCESS_TOKEN=YOUR_POLAR_ACCESS_TOKEN
POLAR_WEBHOOK_SECRET=YOUR_POLAR_WEBHOOK_SECRET
POLAR_ORGANIZATION_ID=YOUR_POLAR_ORG_ID

# ── AI Provider (Groq) ────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY

# ── Application ──────────────────────────────────────────────────────────────
# Local development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Observability (Optional) ─────────────────────────────────────────────────
# Get from: https://sentry.io → Project Settings → Client Keys (DSN)
# SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
# SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed post-auth redirect origins (optional)
# ALLOWED_REDIRECT_ORIGINS=https://your-domain.vercel.app
